FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY swarmlab ./swarmlab
COPY scripts/backup.py scripts/backup_s3.py ./scripts/
RUN pip install --no-cache-dir "boto3>=1.34" \
    && addgroup --system app && adduser --system --ingroup app app \
    && mkdir -p /data /backup && chown -R app:app /app /data /backup
USER app
ENTRYPOINT ["python", "scripts/backup_s3.py"]
CMD ["--help"]
